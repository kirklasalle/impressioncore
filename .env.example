# ===========================================================================
# ImpressionCore Environment Configuration
# ===========================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ===========================================================================

# --- API Security -----------------------------------------------------------
# Required for authenticated API endpoints.  Generate a strong random key.
IMPRESSIONCORE_API_KEY=

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed origins.  Defaults to localhost dev ports
# when unset.  Use "*" ONLY for local development.
#   Production example: https://app.impressioncore.com,https://admin.impressioncore.com
IMPRESSIONCORE_ALLOWED_ORIGINS=

# --- Agent0Core --------------------------------------------------------------
# LLM backend for the Agent0 autonomous layer (default: ollama)
AGENT0CORE_LLM_BACKEND=ollama
# Enable debug logging for Agent0Core (0 = off, 1 = on)
AGENT0CORE_DEBUG=0

# --- Model Paths -------------------------------------------------------------
# Override default model storage locations (optional)
# MODEL_ROOT=F:/models
# CHECKPOINT_ROOT=F:/models/checkpoints
# DATA_ROOT=F:/data/datasets

# --- Docker / Deployment ------------------------------------------------------
# Host path for bound model/data storage when running docker compose.
# If unset, docker-compose.yml defaults to ./data.
# On Windows, use a path like D:/Projects/impressioncore/data or F:/data.
IMPRESSIONCORE_DATA_DRIVE=./data

# Force container execution onto CPU-only mode.
# Set to 1 when GPU support is not available or when running on non-NVIDIA hosts.
IMPRESSIONCORE_FORCE_CPU=0

# --- Hardware ----------------------------------------------------------------
# Force a specific CUDA device (optional, auto-detected if unset)
# CUDA_VISIBLE_DEVICES=0
