class PhonemeEncoder(nn.Module):
    """Advanced phoneme encoder for audio processing"""
    
    def __init__(self, config: ImpressionCoreB1Config):
        super().__init__()
        self.config = config
        
        # Phoneme embedding (IPA has ~100 phonemes + special tokens)
        self.phoneme_vocab_size = 128
        self.phoneme_embedding = nn.Embedding(self.phoneme_vocab_size, config.phoneme_dim)        # Audio feature processor (for raw audio) - using secure loading
        try:
            self.audio_processor = Wav2Vec2Processor.from_pretrained("facebook/wav2vec2-base")
            self.audio_model = load_teacher_model_secure(
                "facebook/wav2vec2-base",
                device=self.config.device if hasattr(self.config, 'device') else 'cpu',
                use_safetensors=True,
                model_type="wav2vec2"
            )
            if self.audio_model is None:
                # Fallback to direct loading if secure loading fails
                self.audio_model = Wav2Vec2Model.from_pretrained("facebook/wav2vec2-base")
        except Exception as e:
            logger.warning(f"Failed to load Wav2Vec2 model securely: {e}")
            # Fallback to direct loading
            self.audio_processor = Wav2Vec2Processor.from_pretrained("facebook/wav2vec2-base")
            self.audio_model = Wav2Vec2Model.from_pretrained("facebook/wav2vec2-base")
        
        # Fusion of phoneme and audio features
        self.feature_fusion = nn.Sequential(
            nn.Linear(config.phoneme_dim + 768, config.audio_dim),
            nn.LayerNorm(config.audio_dim),
            nn.ReLU(),
            nn.Dropout(config.dropout)
        )
        
    def text_to_phonemes(self, text: str) -> List[str]:
        """Convert text to phonemes using phonemizer"""
        if not PHONEMIZER_AVAILABLE:
            # Fallback: simple character-level processing
            return list(text.lower().replace(' ', '_'))
        
        try:
            phonemes = phonemize(text, language='en-us', backend='espeak', strip=True)
            return phonemes.split()
        except Exception as e:
            logger.warning(f"Phoneme conversion failed: {e}")
            return list(text.lower().replace(' ', '_'))  # Fallback
    
    def encode_phonemes(self, phoneme_ids: torch.Tensor) -> torch.Tensor:
        """Encode phoneme sequence"""
        return self.phoneme_embedding(phoneme_ids)
    
    def encode_audio(self, audio_path: str) -> torch.Tensor:
        """Encode raw audio file"""
        if not AUDIO_PROCESSING_AVAILABLE:
            logger.warning("Audio processing not available, returning placeholder")
            return torch.zeros(1, 768)
            
        try:
            # Load audio
            audio, sr = librosa.load(audio_path, sr=16000)
            
            # Process with Wav2Vec2
            inputs = self.audio_processor(audio, sampling_rate=16000, return_tensors="pt")
            with torch.no_grad():
                features = self.audio_model(**inputs).last_hidden_state
            
            return features.squeeze(0)  # Remove batch dimension
        except Exception as e:
            logger.warning(f"Audio encoding failed: {e}")
            return torch.zeros(1, 768)  # Fallback
    
    def forward(self, text: Optional[str] = None, audio_path: Optional[str] = None) -> torch.Tensor:
        """Forward pass with both phoneme and audio encoding"""
        features = []
        
        if text:
            phonemes = self.text_to_phonemes(text)
            if phonemes:
                # Simple phoneme to ID mapping (would be more sophisticated in production)
                phoneme_ids = torch.randint(0, self.phoneme_vocab_size, (len(phonemes),))
                phoneme_features = self.encode_phonemes(phoneme_ids)
                features.append(phoneme_features.mean(dim=0))
            else:
                features.append(torch.zeros(self.config.phoneme_dim))
        
        if audio_path:
            audio_features = self.encode_audio(audio_path)
            features.append(audio_features.mean(dim=0))
        
        if features:
            combined = torch.cat(features, dim=-1)
            return self.feature_fusion(combined.unsqueeze(0))
        else:
            return torch.zeros(1, self.config.audio_dim)

class MultimodalFusionLayer(nn.Module):
    """Advanced multimodal fusion with cross-modal attention"""
    
    def __init__(self, config: ImpressionCoreB1Config):
        super().__init__()
        self.config = config
        
        # Modal projections to common space
        self.text_proj = nn.Linear(config.text_dim, config.hidden_dim)
        self.image_proj = nn.Linear(config.image_dim, config.hidden_dim) 
        self.audio_proj = nn.Linear(config.audio_dim, config.hidden_dim)
        
        # Cross-modal attention layers
        self.cross_attention = nn.MultiheadAttention(
            embed_dim=config.hidden_dim,
            num_heads=config.num_heads,
            dropout=config.dropout,
            batch_first=True
        )
        
        # Fusion transformer layers
        self.fusion_layers = nn.ModuleList([
            nn.TransformerEncoderLayer(
                d_model=config.hidden_dim,
                nhead=config.num_heads,
                dim_feedforward=config.intermediate_size,
                dropout=config.dropout,
                batch_first=True
            )
            for _ in range(3)  # 3 fusion layers
        ])
        
        self.layer_norm = nn.LayerNorm(config.hidden_dim)
        
    def forward(self, 
                text_features: Optional[torch.Tensor] = None,
                image_features: Optional[torch.Tensor] = None, 
                audio_features: Optional[torch.Tensor] = None,
                attention_mask: Optional[torch.Tensor] = None) -> torch.Tensor:
        """Fuse multimodal features with cross-attention"""
        
        modal_features = []
        modal_weights = []
        
        # Project each modality to common space
        if text_features is not None:
            text_proj = self.text_proj(text_features)
            modal_features.append(text_proj)
            modal_weights.append(self.config.text_weight)
            
        if image_features is not None:
            image_proj = self.image_proj(image_features)
            modal_features.append(image_proj)
            modal_weights.append(self.config.image_weight)
            
        if audio_features is not None:
            audio_proj = self.audio_proj(audio_features)
            modal_features.append(audio_proj)
            modal_weights.append(self.config.audio_weight)
        
        if not modal_features:
            return torch.zeros(1, 1, self.config.hidden_dim)
        
        # Concatenate all modalities
        fused = torch.cat(modal_features, dim=1)  # [batch, total_seq, hidden]
        
        # Apply cross-modal attention
        attended, _ = self.cross_attention(fused, fused, fused, key_padding_mask=attention_mask)
        
        # Apply fusion transformer layers
        for layer in self.fusion_layers:
            attended = layer(attended, src_key_padding_mask=attention_mask)
        
        return self.layer_norm(attended)

class MixtureOfExpertsLayer(nn.Module):
    """Advanced Mixture of Experts with learnable routing"""
    
    def __init__(self, config: ImpressionCoreB1Config):
        super().__init__()
        self.config = config
        self.num_experts = config.num_experts
        self.experts_per_token = config.experts_per_token
        
        # Router network
        self.router = nn.Linear(config.hidden_dim, config.num_experts)
        
        # Expert networks
        self.experts = nn.ModuleList([
            nn.Sequential(
                nn.Linear(config.hidden_dim, config.expert_dim),
                nn.ReLU(),
                nn.Dropout(config.dropout),
                nn.Linear(config.expert_dim, config.hidden_dim)
            )
            for _ in range(config.num_experts)
        ])
        
        # Load balancing
        self.register_buffer('expert_usage', torch.zeros(config.num_experts))
        
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        """Route tokens to experts"""
        batch_size, seq_len, hidden_dim = x.shape
        x_flat = x.view(-1, hidden_dim)  # [batch*seq, hidden]
        
        # Router decides which experts to use
        router_logits = self.router(x_flat)  # [batch*seq, num_experts]
        router_probs = F.softmax(router_logits, dim=-1)
        
        # Select top-k experts per token
        top_k_probs, top_k_indices = torch.topk(router_probs, self.experts_per_token, dim=-1)
        top_k_probs = top_k_probs / top_k_probs.sum(dim=-1, keepdim=True)  # Renormalize
        
        # Process through selected experts
        outputs = torch.zeros_like(x_flat)
        
        for i in range(self.experts_per_token):
            expert_indices = top_k_indices[:, i]
            expert_probs = top_k_probs[:, i:i+1]
            
            for expert_id in range(self.num_experts):
                mask = (expert_indices == expert_id)
                if mask.any():
                    expert_input = x_flat[mask]
                    expert_output = self.experts[expert_id](expert_input)
                    outputs[mask] += expert_probs[mask] * expert_output
                    
                    # Update usage tracking
                    self.expert_usage[expert_id] += mask.sum().float()
        
        return outputs.view(batch_size, seq_len, hidden_dim)

class BrainSimulationAdapter(nn.Module):
    """Brain-inspired processing adapter"""
    
    def __init__(self, config: ImpressionCoreB1Config):
        super().__init__()
        self.config = config
        
        # Working memory simulation
        self.working_memory = nn.GRU(
            input_size=config.hidden_dim,
            hidden_size=config.hidden_dim,
            num_layers=2,
            batch_first=True,
            dropout=config.dropout
        )
        
        # Attention modulation (like prefrontal cortex)
        self.attention_modulator = nn.Sequential(
            nn.Linear(config.hidden_dim, config.hidden_dim // 2),
            nn.Tanh(),
            nn.Linear(config.hidden_dim // 2, config.hidden_dim),
            nn.Sigmoid()
        )
        
        # Memory consolidation
        self.memory_consolidator = nn.Linear(config.hidden_dim, config.hidden_dim)
        
    def forward(self, x: torch.Tensor, memory_state: Optional[torch.Tensor] = None) -> Tuple[torch.Tensor, torch.Tensor]:
        """Brain-inspired processing"""
        
        # Working memory processing
        working_output, new_memory_state = self.working_memory(x, memory_state)
        
        # Attention modulation
        attention_weights = self.attention_modulator(working_output)
        modulated = working_output * attention_weights
        
        # Memory consolidation
        consolidated = self.memory_consolidator(modulated)
        
        return consolidated, new_memory_state

class ImpressionCoreB1Model(nn.Module):
    """The most advanced multimodal architecture ever designed"""
    
    def __init__(self, config: ImpressionCoreB1Config):
        super().__init__()
        self.config = config        # Initialize encoders with secure loading
        self.text_encoder = load_teacher_model_secure(
            "microsoft/DialoGPT-small",
            device=config.device if hasattr(config, 'device') else 'cpu',
            use_safetensors=True,
            model_type="auto"
        )
        if self.text_encoder is None:
            # Fallback to direct loading if secure loading fails
            logger.warning("Secure loading failed for DialoGPT-small, using direct loading")
            self.text_encoder = AutoModel.from_pretrained("microsoft/DialoGPT-small")
            
        # Load CLIP model securely
        clip_model = load_teacher_model_secure(
            "openai/clip-vit-base-patch32",
            device=config.device if hasattr(config, 'device') else 'cpu',
            use_safetensors=True,
            model_type="clip"
        )
        if clip_model is not None:
            self.image_encoder = clip_model.vision_model
        else:
            logger.warning("Secure loading failed for CLIP, using direct loading")
            self.image_encoder = CLIPModel.from_pretrained("openai/clip-vit-base-patch32").vision_model
        self.audio_encoder = PhonemeEncoder(config)
        
        # Core components
        self.multimodal_fusion = MultimodalFusionLayer(config)
        self.mixture_of_experts = MixtureOfExpertsLayer(config)
        self.brain_adapter = BrainSimulationAdapter(config)
        
        # Output heads for each modality
        self.text_head = nn.Linear(config.hidden_dim, 50257)  # GPT-2 vocab size
        self.image_head = nn.Linear(config.hidden_dim, config.image_dim)
        self.audio_head = nn.Linear(config.hidden_dim, config.audio_dim)
        
        # Initialize processors
        self.text_tokenizer = GPT2Tokenizer.from_pretrained("gpt2")
        self.text_tokenizer.pad_token = self.text_tokenizer.eos_token
        self.image_processor = CLIPProcessor.from_pretrained("openai/clip-vit-base-patch32")
        
        self.apply(self._init_weights)
        
    def _init_weights(self, module):
        """Initialize weights"""
        if isinstance(module, nn.Linear):
            torch.nn.init.normal_(module.weight, mean=0.0, std=0.02)
            if module.bias is not None:
                torch.nn.init.zeros_(module.bias)
        elif isinstance(module, nn.Embedding):
            torch.nn.init.normal_(module.weight, mean=0.0, std=0.02)
    
    def encode_text(self, texts: List[str]) -> torch.Tensor:
        """Encode text inputs"""
        tokens = self.text_tokenizer(
            texts, 
            return_tensors="pt", 
            padding=True, 
            truncation=True,
            max_length=self.config.max_sequence_length
        )
        
        with torch.no_grad():
            outputs = self.text_encoder(**tokens)
            return outputs.last_hidden_state
    
    def encode_image(self, images: List[Image.Image]) -> torch.Tensor:
        """Encode image inputs"""
        processed = self.image_processor(images=images, return_tensors="pt")
        
        with torch.no_grad():
            outputs = self.image_encoder(**processed)
            return outputs.last_hidden_state
    
    def encode_audio(self, audio_data: List[str]) -> torch.Tensor:
        """Encode audio inputs (file paths or text for phonemes)"""
        audio_features = []
        
        for item in audio_data:
            if isinstance(item, str):
                if item.endswith(('.wav', '.mp3', '.flac')):
                    # Audio file
                    features = self.audio_encoder(audio_path=item)
                else:
                    # Text for phoneme extraction
                    features = self.audio_encoder(text=item)
                audio_features.append(features)
        
        return torch.stack(audio_features, dim=0)
    
    def forward(self, 
                text_input: Optional[List[str]] = None,
                image_input: Optional[List[Image.Image]] = None,
                audio_input: Optional[List[str]] = None,
                target_modality: str = "text") -> Dict[str, torch.Tensor]:
        """Forward pass through the complete architecture"""
        
        # Encode all modalities
        text_features = self.encode_text(text_input) if text_input else None
        image_features = self.encode_image(image_input) if image_input else None
        audio_features = self.encode_audio(audio_input) if audio_input else None
        
        # Multimodal fusion
        if self.config.gradient_checkpointing:
            fused_features = checkpoint(
                self.multimodal_fusion,
                text_features,
                image_features, 
                audio_features
            )
        else:
            fused_features = self.multimodal_fusion(text_features, image_features, audio_features)
        
        # Mixture of Experts processing
        expert_output = self.mixture_of_experts(fused_features)
        
        # Brain simulation processing
        brain_output, memory_state = self.brain_adapter(expert_output)
        
        # Generate outputs for target modality
        outputs = {}
        
        if target_modality == "text" or target_modality == "all":
            outputs["text_logits"] = self.text_head(brain_output)
            
        if target_modality == "image" or target_modality == "all":
            outputs["image_features"] = self.image_head(brain_output)
            
        if target_modality == "audio" or target_modality == "all":
            outputs["audio_features"] = self.audio_head(brain_output)
        
        outputs["hidden_states"] = brain_output
        outputs["memory_state"] = memory_state
        
        return outputs

class ImpressionCoreB1Dataset(Dataset):
    """Advanced multimodal dataset for ImpressionCore-B1 with F: Drive embedding integration"""
    
    def __init__(self, data_path: str, config: ImpressionCoreB1Config, embedding_loader=None):
        self.config = config
        self.data_path = Path(data_path)
        self.embedding_loader = embedding_loader
          # Load the ultimate world-class dataset
        dataset_file = self.data_path / "ULTIMATE_WORLD_CLASS_DATASET_20250613_233615.json"
        
        if dataset_file.exists():
            with open(dataset_file, 'r', encoding='utf-8') as f:
                dataset_content = json.load(f)
            
            # Handle different dataset formats
            if isinstance(dataset_content, list):
                self.data = dataset_content
            elif isinstance(dataset_content, dict) and 'examples' in dataset_content:
                self.data = dataset_content['examples']
                logger.info(f"📊 Dataset Info: {dataset_content.get('dataset_info', {})}")
            else:
                logger.warning("Unknown dataset format, trying to extract data...")
                self.data = list(dataset_content.values()) if isinstance(dataset_content, dict) else []
            
            logger.info(f"✅ Loaded {len(self.data)} examples from ULTIMATE_WORLD_CLASS dataset")
        else:
            logger.error(f"Dataset file not found: {dataset_file}")
            logger.info("🎯 Creating synthetic dataset as fallback")
            self.data = self._create_synthetic_dataset()
        
        # Initialize embedding integration
