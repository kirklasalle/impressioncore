import os
import json
import logging
from datetime import datetime
from typing import Dict, Any, Optional

# Set up logging
logger = logging.getLogger("memlog")

# Directory constants - F: drive configuration for Sacred Covenant compliance
BASE_DIR = os.path.dirname(__file__)

# Check F: drive availability properly
F_DRIVE_AVAILABLE = os.path.exists("F:") and os.path.isdir("F:")

if F_DRIVE_AVAILABLE:
    # Use F: drive for Sacred Covenant compliance
    F_DRIVE_BASE = "F:\\ImpressionCore"
    PERSISTENCE_DIR = os.path.join(F_DRIVE_BASE, "persistence")
    STATE_DIR = os.path.join(F_DRIVE_BASE, "state")
    TASKS_DIR = os.path.join(F_DRIVE_BASE, "tasks")
    BACKUP_DIR = os.path.join(F_DRIVE_BASE, "backups")
    logger.info("F: drive available - using F: drive for Sacred Covenant compliance")
else:
    # Fallback to local directories if F: drive is not available
    logger.warning("F: drive not available, using local directories as fallback")
    PERSISTENCE_DIR = os.path.join(BASE_DIR, "persistence")
    STATE_DIR = os.path.join(BASE_DIR, "state")
    TASKS_DIR = os.path.join(BASE_DIR, "tasks")
    BACKUP_DIR = os.path.join(BASE_DIR, "backups")

# Ensure directories exist
os.makedirs(PERSISTENCE_DIR, exist_ok=True)
os.makedirs(STATE_DIR, exist_ok=True)
os.makedirs(TASKS_DIR, exist_ok=True)
os.makedirs(BACKUP_DIR, exist_ok=True)

logger.info(f"ImpressionCore memlog initialized with F: drive integration")
logger.info(f"Persistence: {PERSISTENCE_DIR}")
logger.info(f"State: {STATE_DIR}")
logger.info(f"Tasks: {TASKS_DIR}")
logger.info(f"Backups: {BACKUP_DIR}")


def store_persistent_data(key: str, data: Any) -> bool:
    """
    Store persistent data to disk.
    
    Args:
        key: Data key identifier
        data: Data to store
        
    Returns:
        True if successful, False otherwise
    """
    try:
        filepath = os.path.join(PERSISTENCE_DIR, f"{key}.json")
        with open(filepath, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=2, ensure_ascii=False, default=str)
        return True
    except Exception as e:
        logger.error(f"Error storing persistent data for key '{key}': {e}")
        return False


def get_persistent_data(key: str, default: Any = None) -> Any:
    """
    Retrieve persistent data from disk.
    
    Args:
        key: Data key identifier
        default: Default value if key not found
        
    Returns:
        Stored data or default value
    """
    try:
        filepath = os.path.join(PERSISTENCE_DIR, f"{key}.json")
        if os.path.exists(filepath):
            with open(filepath, 'r', encoding='utf-8') as f:
                return json.load(f)
        return default
    except Exception as e:
        logger.error(f"Error retrieving persistent data for key '{key}': {e}")
        return default


def log_state_change(state_data: Dict[str, Any]) -> bool:
    """
    Log a state change to the F: drive state directory.
    
    Args:
        state_data: State information to log
        
    Returns:
        True if successful, False otherwise
    """
    try:
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S_%f")
        filename = f"state_{timestamp}.json"
        filepath = os.path.join(STATE_DIR, filename)
        
        state_entry = {
            "timestamp": datetime.now().isoformat(),
            "state": state_data
        }
        
        with open(filepath, 'w', encoding='utf-8') as f:
            json.dump(state_entry, f, indent=2, ensure_ascii=False, default=str)
        
        logger.debug(f"Logged state change to {filepath}")
        return True
    except Exception as e:
        logger.error(f"Error logging state change: {e}")
        return False


def log_task(task_data: Dict[str, Any]) -> bool:
    """
    Log a task to the F: drive tasks directory.
    
    Args:
        task_data: Task information to log
        
    Returns:
        True if successful, False otherwise
    """
    try:
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S_%f")
        filename = f"task_{timestamp}.json"
        filepath = os.path.join(TASKS_DIR, filename)
        
        task_entry = {
            "timestamp": datetime.now().isoformat(),
            "task": task_data
        }
        
        with open(filepath, 'w', encoding='utf-8') as f:
            json.dump(task_entry, f, indent=2, ensure_ascii=False, default=str)
        
        logger.debug(f"Logged task to {filepath}")
        return True
    except Exception as e:
        logger.error(f"Error logging task: {e}")
        return False


# Sacred Covenant File Protection
# Basic model file protection (comprehensive oversight handled by MCP Server)
MODEL_PROTECTION_DIR = os.path.join(BACKUP_DIR, "model_protection")
os.makedirs(MODEL_PROTECTION_DIR, exist_ok=True)

logger.info("🛡️ Sacred Covenant: Basic file protection initialized")
logger.info(f"🗂️ F: Drive Available: {F_DRIVE_AVAILABLE}")
logger.info(f"📁 Persistence Directory: {PERSISTENCE_DIR}")
logger.info(f"💾 Backup Directory: {BACKUP_DIR}")
logger.info(f"🔐 Model Protection: {MODEL_PROTECTION_DIR}")


def log_model_activity(activity_type: str, model_data: Dict[str, Any]) -> bool:
    """
    Log ImpressionCore-B1 model activities (lightweight logging only).
    
    Note: Comprehensive oversight is handled by the impressioncore-vrgc MCP Server.
    
    Args:
        activity_type: Type of model activity (training, checkpoint, evaluation, etc.)
        model_data: Model activity information
        
    Returns:
        True if successful, False otherwise
    """
    try:
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S_%f")
        filename = f"b1_model_activity_{activity_type}_{timestamp}.json"
        filepath = os.path.join(MODEL_PROTECTION_DIR, filename)
        
        activity_entry = {
            "timestamp": datetime.now().isoformat(),
            "model_name": "ImpressionCore-B1",
            "activity_type": activity_type,
            "sacred_covenant_oversight": True,
            "data": model_data
        }
        
        with open(filepath, 'w', encoding='utf-8') as f:
            json.dump(activity_entry, f, indent=2, ensure_ascii=False, default=str)
        
        logger.info(f"🛡️ Sacred Covenant: Logged ImpressionCore-B1 {activity_type} activity to {filepath}")
        return True
    except Exception as e:
        logger.error(f"💥 Sacred Covenant VIOLATION: Failed to log model activity: {e}")
        return False


def protect_model_checkpoint(checkpoint_path: str, checkpoint_metadata: Dict[str, Any]) -> bool:
    """
    Create protected backup of ImpressionCore-B1 model checkpoint.
    
    Args:
        checkpoint_path: Path to the checkpoint to protect
        checkpoint_metadata: Metadata about the checkpoint
        
    Returns:
        True if successful, False otherwise
    """
    try:
        import shutil
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        checkpoint_name = os.path.basename(checkpoint_path)
        protected_path = os.path.join(CHECKPOINT_BACKUP_DIR, f"protected_{timestamp}_{checkpoint_name}")
        
        # Copy checkpoint to protected location
        if os.path.exists(checkpoint_path):
            shutil.copy2(checkpoint_path, protected_path)
            
            # Log the protection action
            protection_data = {
                "original_path": checkpoint_path,
                "protected_path": protected_path,
                "metadata": checkpoint_metadata,
                "protection_timestamp": timestamp
            }
            
            log_model_activity("checkpoint_protection", protection_data)
            logger.info(f"🛡️ Sacred Covenant: Protected ImpressionCore-B1 checkpoint at {protected_path}")
            return True
        else:
            logger.warning(f"⚠️ Sacred Covenant: Checkpoint not found for protection: {checkpoint_path}")
            return False
            
    except Exception as e:
        logger.error(f"💥 Sacred Covenant VIOLATION: Failed to protect checkpoint: {e}")
        return False


def monitor_training_progress(training_metrics: Dict[str, Any]) -> bool:
    """
    Monitor ImpressionCore-B1 training progress for Sacred Covenant compliance.
    
    Args:
        training_metrics: Training metrics and progress data
        
    Returns:
        True if monitoring successful, False otherwise
    """
    try:
        # Check for critical training milestones
        critical_metrics = {
            "loss": training_metrics.get("loss", float('inf')),
            "epoch": training_metrics.get("epoch", 0),
            "learning_rate": training_metrics.get("learning_rate", 0),
            "vram_usage": training_metrics.get("vram_usage", 0),
            "conversation_quality": training_metrics.get("conversation_quality", 0)
        }
        
        # Sacred Covenant Quality Gate: Ensure we're progressing toward 10/10 quality
        if critical_metrics["conversation_quality"] >= 8.0:
            logger.info(f"🎯 Sacred Covenant: ImpressionCore-B1 approaching excellence - Quality: {critical_metrics['conversation_quality']}/10")
        elif critical_metrics["conversation_quality"] >= 6.0:
            logger.info(f"📈 Sacred Covenant: ImpressionCore-B1 making good progress - Quality: {critical_metrics['conversation_quality']}/10")
        else:
            logger.warning(f"⚠️ Sacred Covenant: ImpressionCore-B1 needs attention - Quality: {critical_metrics['conversation_quality']}/10")
        
        # Log training progress
        log_model_activity("training_progress", {
            "metrics": critical_metrics,
            "gtx_1050_ti_optimized": training_metrics.get("gtx_1050_ti_optimized", False),
            "embedding_integration": training_metrics.get("embedding_integration", False)
        })
        
        return True
    except Exception as e:
        logger.error(f"💥 Sacred Covenant VIOLATION: Failed to monitor training: {e}")
        return False


def validate_model_integrity(model_path: str) -> bool:
    """
    Validate ImpressionCore-B1 model integrity for Sacred Covenant compliance.
    
    Args:
        model_path: Path to the model to validate
        
    Returns:
        True if model is valid, False otherwise
    """
    try:
        if not os.path.exists(model_path):
            logger.error(f"💥 Sacred Covenant VIOLATION: Model not found at {model_path}")
            return False
        
        # Get model file size
        model_size = os.path.getsize(model_path)
        
        # Log integrity check
        integrity_data = {
            "model_path": model_path,
            "model_size_bytes": model_size,
            "model_size_mb": model_size / (1024 * 1024),
            "integrity_check_passed": True
        }
        
        log_model_activity("integrity_validation", integrity_data)
        logger.info(f"✅ Sacred Covenant: ImpressionCore-B1 integrity validated - Size: {model_size / (1024 * 1024):.2f} MB")
        return True
        
    except Exception as e:
        logger.error(f"💥 Sacred Covenant VIOLATION: Model integrity check failed: {e}")
        return False


def log_embedding_integration(embedding_stats: Dict[str, Any]) -> bool:
    """
    Log F: drive embedding integration for Sacred Covenant oversight.
    
    Args:
        embedding_stats: Statistics about embedding integration
        
    Returns:
        True if successful, False otherwise
    """
    try:
        # Sacred Covenant requires complete embedding oversight
        embedding_data = {
            "total_embeddings": embedding_stats.get("total_embeddings", 0),
            "f_drive_path": embedding_stats.get("f_drive_path", ""),
            "embedding_types": embedding_stats.get("embedding_types", []),
            "integration_status": embedding_stats.get("integration_status", "unknown"),
            "sacred_covenant_compliance": True
        }
        
        log_model_activity("embedding_integration", embedding_data)
        
        if embedding_data["total_embeddings"] >= 5000000:  # 5M+ embeddings
            logger.info(f"🚀 Sacred Covenant: Excellent embedding coverage - {embedding_data['total_embeddings']:,} embeddings")
        else:
            logger.warning(f"⚠️ Sacred Covenant: Need more embeddings - {embedding_data['total_embeddings']:,} embeddings")
        
        return True
    except Exception as e:
        logger.error(f"💥 Sacred Covenant VIOLATION: Failed to log embedding integration: {e}")
        return False


