<div class="section-card">
    <h4>Text Tokenizer</h4>
    <p>Train and use text tokenizers with Byte-Pair Encoding (BPE) algorithm.</p>

    <div class="card mb-4 p-3 bg-light">
        <h5><i class="bi bi-gear"></i> Tokenizer Training</h5>
        <form id="text-tokenizer-form">
            <div class="mb-3">
                <label for="training-text" class="form-label">Training Text:</label>
                <textarea class="form-control" id="training-text" rows="4" placeholder="Enter training text..."></textarea>
            </div>
            <div class="mb-3">
                <label for="vocab-size" class="form-label">Vocabulary Size:</label>
                <input type="number" class="form-control" id="vocab-size" value="1000" min="100" max="50000">
            </div>
            <button type="submit" class="btn btn-primary">Train Tokenizer</button>
        </form>
        <div id="training-result" class="mt-3" style="display: none;"></div>
    </div>

    <div class="card mb-4 p-3 bg-light">
        <h5><i class="bi bi-play"></i> Try Tokenizer</h5>
        <form id="text-tokenize-form">
            <div class="mb-3">
                <label for="input-text" class="form-label">Text to Tokenize:</label>
                <textarea class="form-control" id="input-text" rows="3" placeholder="Enter text to tokenize..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Tokenize</button>
        </form>
        <div id="tokenize-result" class="mt-3" style="display: none;">
            <h6>Tokens:</h6>
            <div class="tokenization-demo" id="token-display"></div>
        </div>
    </div>
</div>

<script>
document.getElementById('text-tokenizer-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    const resultDiv = document.getElementById('training-result');
    resultDiv.innerHTML = '<div class="alert alert-info">Training tokenizer...</div>';
    resultDiv.style.display = 'block';

    try {
        const response = await fetch('/train_tokenizer', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                text: document.getElementById('training-text').value,
                vocab_size: parseInt(document.getElementById('vocab-size').value)
            })
        });
        const data = await response.json();
        if (data.error) {
            resultDiv.innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
        } else {
            resultDiv.innerHTML = `
                <div class="alert alert-success">
                    Tokenizer trained successfully!<br>
                    Vocabulary size: ${data.vocab_size}<br>
                    Training completed in: ${data.training_time}s
                </div>`;
        }
    } catch (error) {
        resultDiv.innerHTML = `<div class="alert alert-danger">Error: ${error.message}</div>`;
    }
});

document.getElementById('text-tokenize-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    const resultDiv = document.getElementById('tokenize-result');
    const tokenDisplay = document.getElementById('token-display');
    resultDiv.style.display = 'block';
    tokenDisplay.innerHTML = '<div class="text-center"><div class="spinner-border"></div></div>';

    try {
        const response = await fetch('/tokenize_text', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                text: document.getElementById('input-text').value
            })
        });
        const data = await response.json();
        if (data.error) {
            tokenDisplay.innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
        } else {
            tokenDisplay.innerHTML = data.tokens.map(token => 
                `<span class="token-box">${token}</span>`
            ).join(' ');
        }
    } catch (error) {
        tokenDisplay.innerHTML = `<div class="alert alert-danger">Error: ${error.message}</div>`;
    }
});
</script>
