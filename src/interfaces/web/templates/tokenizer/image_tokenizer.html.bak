<div class="section-card">
    <h4>Image Tokenizer</h4>
    <p>Train and use image tokenizers with patch-based encoding and multi-scale reconstruction.</p>

    <div class="card mb-4 p-3 bg-light">
        <h5><i class="bi bi-gear"></i> Image Tokenizer Training</h5>
        <form id="image-tokenizer-form">
            <div class="mb-3">
                <label for="image-upload" class="form-label">Training Images:</label>
                <input type="file" class="form-control" id="image-upload" multiple accept="image/*">
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label for="num-tokens" class="form-label">Number of Tokens:</label>
                        <input type="number" class="form-control" id="num-tokens" value="1000" min="100" max="10000">
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label for="patch-size" class="form-label">Patch Size:</label>
                        <input type="number" class="form-control" id="patch-size" value="8" min="4" max="32">
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label for="d-model" class="form-label">Hidden Size:</label>
                        <input type="number" class="form-control" id="d-model" value="512" min="128" max="1024">
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Train Tokenizer</button>
        </form>
        <div id="training-progress" class="mt-3" style="display: none;">
            <div class="progress">
                <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%"></div>
            </div>
            <div class="text-center mt-2" id="progress-text"></div>
        </div>
        <div id="training-result" class="mt-3" style="display: none;"></div>
    </div>

    <div class="card mb-4 p-3 bg-light">
        <h5><i class="bi bi-play"></i> Try Tokenizer</h5>
        <form id="image-tokenize-form">
            <div class="mb-3">
                <label for="input-image" class="form-label">Image to Tokenize:</label>
                <input type="file" class="form-control" id="input-image" accept="image/*">
            </div>
            <div class="mb-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="show-reconstruction" checked>
                    <label class="form-check-label" for="show-reconstruction">Show Reconstruction</label>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Tokenize</button>
        </form>
        <div id="tokenize-result" class="mt-3" style="display: none;">
            <div class="row">
                <div class="col-md-6">
                    <h6>Original Image:</h6>
                    <img id="original-image" class="img-fluid" style="max-width: 100%;">
                </div>
                <div class="col-md-6">
                    <h6>Reconstructed Image:</h6>
                    <img id="reconstructed-image" class="img-fluid" style="max-width: 100%;">
                </div>
            </div>
            <div class="mt-3">
                <h6>Image Tokens:</h6>
                <div class="tokenization-demo" id="token-display"></div>
            </div>
            <div class="mt-3">
                <h6>Reconstruction Quality:</h6>
                <table class="table table-sm">
                    <tr><td>SSIM:</td><td id="ssim-value">-</td></tr>
                    <tr><td>PSNR:</td><td id="psnr-value">-</td></tr>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('image-tokenizer-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData();
    const files = document.getElementById('image-upload').files;
    const progress = document.getElementById('training-progress');
    const progressBar = progress.querySelector('.progress-bar');
    const progressText = document.getElementById('progress-text');
    const resultDiv = document.getElementById('training-result');

    for (let file of files) {
        formData.append('images[]', file);
    }
    formData.append('num_tokens', document.getElementById('num-tokens').value);
    formData.append('patch_size', document.getElementById('patch-size').value);
    formData.append('d_model', document.getElementById('d-model').value);

    progress.style.display = 'block';
    resultDiv.style.display = 'none';
    progressBar.style.width = '0%';
    progressText.textContent = 'Starting training...';

    try {
        const response = await fetch('/train_image_tokenizer', {
            method: 'POST',
            body: formData
        });
        const data = await response.json();
        if (data.error) {
            resultDiv.innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
        } else {
            resultDiv.innerHTML = `
                <div class="alert alert-success">
                    Image tokenizer trained successfully!<br>
                    Number of tokens: ${data.num_tokens}<br>
                    Patch size: ${data.patch_size}<br>
                    Training completed in: ${data.training_time}s
                </div>`;
        }
    } catch (error) {
        resultDiv.innerHTML = `<div class="alert alert-danger">Error: ${error.message}</div>`;
    } finally {
        progress.style.display = 'none';
        resultDiv.style.display = 'block';
    }
});

document.getElementById('image-tokenize-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData();
    const file = document.getElementById('input-image').files[0];
    const showReconstruction = document.getElementById('show-reconstruction').checked;
    const resultDiv = document.getElementById('tokenize-result');

    formData.append('image', file);
    formData.append('show_reconstruction', showReconstruction);

    try {
        const response = await fetch('/tokenize_image', {
            method: 'POST',
            body: formData
        });
        const data = await response.json();
        if (data.error) {
            resultDiv.innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
        } else {
            // Display original and reconstructed images
            document.getElementById('original-image').src = `data:image/png;base64,${data.original_image}`;
            document.getElementById('reconstructed-image').src = `data:image/png;base64,${data.reconstructed_image}`;
            
            // Display tokens
            document.getElementById('token-display').innerHTML = data.tokens.map(token => 
                `<span class="token-box" title="Token ${token}">${token}</span>`
            ).join(' ');
            
            // Display quality metrics
            document.getElementById('ssim-value').textContent = data.ssim.toFixed(3);
            document.getElementById('psnr-value').textContent = data.psnr.toFixed(2) + ' dB';
            
            resultDiv.style.display = 'block';
        }
    } catch (error) {
        resultDiv.innerHTML = `<div class="alert alert-danger">Error: ${error.message}</div>`;
    }
});

// Add event listeners for WebSocket progress updates
const ws = new WebSocket(`ws://${window.location.host}/ws/training_progress`);
ws.onmessage = function(event) {
    const data = JSON.parse(event.data);
    const progressBar = document.querySelector('.progress-bar');
    const progressText = document.getElementById('progress-text');
    
    progressBar.style.width = `${data.progress}%`;
    progressText.textContent = data.message;
};
</script>
