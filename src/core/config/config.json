{
    "text_tokenizer": {
        "vocab_size": 1000,
        "training": {
            "batch_size": 32,
            "min_frequency": 2
        }
    },
    "image_tokenizer": {
        "architecture": {
            "image_size": 224,
            "patch_size": 8,
            "num_tokens": 1000,
            "d_model": 512,
            "decoder_dim": 1024,
            "refinement_channels": [
                64,
                128,
                256,
                256,
                128,
                64
            ]
        },
        "training": {
            "batch_size": 32,
            "epochs": 100,
            "learning_rate": 1e-3,
            "scheduler_patience": 5,
            "scheduler_factor": 0.5,
            "loss_weights": {
                "reconstruction": 1.0,
                "perceptual": 0.75,
                "diversity": 0.01,
                "multi_scale": {
                    "full": 1.0,
                    "half": 0.5,
                    "quarter": 0.25
                }
            }
        }
    },
    "paths": {
        "text_corpus": "data/text_corpus",
        "image_data": "data/images",
        "tokenizers": "data/tokenizers",
        "output": "output"
    }
}