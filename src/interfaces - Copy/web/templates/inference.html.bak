<div class="section-card">
    <h4>Model Inference</h4>
    <p>Run inference on your trained model.</p>

    <div class="card mb-4 p-3 bg-light">
        <h5><i class="bi bi-lightning"></i> Real-time Inference</h5>
        <div class="mb-3">
            <label for="inference-input" class="form-label">Input:</label>
            <textarea class="form-control" id="inference-input" rows="3"></textarea>
        </div>
        <button class="btn btn-primary" id="run-inference-btn">
            <i class="bi bi-play"></i> Run Inference
        </button>
        <div id="inference-result" class="mt-3" style="display: none;"></div>
    </div>

    <div class="card mb-4 p-3 bg-light">
        <h5><i class="bi bi-gear"></i> Inference Settings</h5>
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="batch-size" class="form-label">Batch Size:</label>
                    <input type="number" class="form-control" id="batch-size" value="1" min="1" max="32">
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="inference-device" class="form-label">Device:</label>
                    <select class="form-select" id="inference-device">
                        <option value="cuda">CUDA (GPU)</option>
                        <option value="cpu">CPU</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4 p-3 bg-light">
        <h5><i class="bi bi-speedometer2"></i> Performance Metrics</h5>
        <div id="inference-metrics" class="row">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body text-center">
                        <h6>Latency</h6>
                        <div id="latency-value">-</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body text-center">
                        <h6>Throughput</h6>
                        <div id="throughput-value">-</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body text-center">
                        <h6>Memory Usage</h6>
                        <div id="memory-value">-</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
