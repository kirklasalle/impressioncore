<div class="section-card">
    <h4>Model Training</h4>
    <p>Configure and monitor your model training process.</p>

    <div class="card mb-4 p-3 bg-light">
        <h5><i class="bi bi-sliders"></i> Training Configuration</h5>
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="learning-rate" class="form-label">Learning Rate:</label>
                    <input type="number" class="form-control" id="learning-rate" value="0.001" min="0.0001" max="0.1" step="0.0001">
                </div>
                <div class="mb-3">
                    <label for="num-epochs" class="form-label">Number of Epochs:</label>
                    <input type="number" class="form-control" id="num-epochs" value="10" min="1" max="100">
                </div>
                <div class="mb-3">
                    <label for="warmup-steps" class="form-label">Warmup Steps:</label>
                    <input type="number" class="form-control" id="warmup-steps" value="1000" min="0" max="10000">
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="optimizer" class="form-label">Optimizer:</label>
                    <select class="form-select" id="optimizer">
                        <option value="adam">Adam</option>
                        <option value="adamw">AdamW</option>
                        <option value="sgd">SGD</option>
                        <option value="lion">Lion</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="scheduler" class="form-label">Learning Rate Scheduler:</label>
                    <select class="form-select" id="scheduler">
                        <option value="linear">Linear Decay</option>
                        <option value="cosine">Cosine</option>
                        <option value="exponential">Exponential</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="gradient-clip" class="form-label">Gradient Clip Value:</label>
                    <input type="number" class="form-control" id="gradient-clip" value="1.0" min="0.1" max="10.0" step="0.1">
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4 p-3 bg-light">
        <h5><i class="bi bi-hdd-rack"></i> Hardware Configuration</h5>
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="device" class="form-label">Training Device:</label>
                    <select class="form-select" id="device">
                        <option value="cuda">CUDA (GPU)</option>
                        <option value="cpu">CPU</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="precision" class="form-label">Training Precision:</label>
                    <select class="form-select" id="precision">
                        <option value="fp16">Mixed Precision (FP16)</option>
                        <option value="bf16">BFloat16</option>
                        <option value="fp32">Full Precision (FP32)</option>
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="distributed" class="form-label">Distributed Training:</label>
                    <select class="form-select" id="distributed">
                        <option value="none">None</option>
                        <option value="ddp">DistributedDataParallel</option>
                        <option value="fsdp">FSDP</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="gradient-checkpointing" class="form-label">Memory Optimization:</label>
                    <select class="form-select" id="gradient-checkpointing">
                        <option value="none">None</option>
                        <option value="checkpoint">Gradient Checkpointing</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4 p-3 bg-light">
        <h5><i class="bi bi-graph-up"></i> Training Progress</h5>
        <div id="training-status" class="alert alert-info" style="display: none;">
            Training status will appear here...
        </div>
        <div class="row">
            <div class="col-md-6">
                <canvas id="loss-chart"></canvas>
            </div>
            <div class="col-md-6">
                <canvas id="metrics-chart"></canvas>
            </div>
        </div>
        <div class="mt-3">
            <button class="btn btn-primary" id="start-training-btn">
                <i class="bi bi-play-circle"></i> Start Training
            </button>
            <button class="btn btn-danger" id="stop-training-btn" style="display: none;">
                <i class="bi bi-stop-circle"></i> Stop Training
            </button>
            <button class="btn btn-warning" id="pause-training-btn" style="display: none;">
                <i class="bi bi-pause-circle"></i> Pause Training
            </button>
        </div>
    </div>

    <div class="card mb-4 p-3 bg-light">
        <h5><i class="bi bi-clock-history"></i> Training History</h5>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Epoch</th>
                        <th>Training Loss</th>
                        <th>Validation Loss</th>
                        <th>Learning Rate</th>
                        <th>Time Elapsed</th>
                    </tr>
                </thead>
                <tbody id="training-history">
                    <!-- Training history will be inserted here -->
                </tbody>
            </table>
        </div>
    </div>
</div>
