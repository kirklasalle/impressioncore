{% extends "layout.html" %}
{% block content %}
<div class="section-card">
    <h1>Welcome to ImpressionCore</h1>
    <div class="note">
        <p><b>Welcome!</b> This walkthrough will guide you through the process of creating, training, and deploying models using ImpressionCore.</p>
    </div>

    <div class="card mb-4 p-3 bg-light">
        <h2>Getting Started</h2>
        <p>Follow these steps to build your model:</p>
        <ol>
            <li>
                <a href="/setup" class="nav-link">
                    <i class="bi bi-gear"></i> Set up your environment
                </a>
            </li>
            <li>
                <a href="/define_model" class="nav-link">
                    <i class="bi bi-diagram-3"></i> Define your model architecture
                </a>
            </li>
            <li>
                <a href="/data_prep" class="nav-link">
                    <i class="bi bi-database"></i> Prepare your data
                </a>
            </li>
            <li>
                <a href="/tokenizer" class="nav-link">
                    <i class="bi bi-code-square"></i> Configure tokenization
                </a>
            </li>
            <li>
                <a href="/pretrain" class="nav-link">
                    <i class="bi bi-reception-4"></i> Pretrain your model (optional)
                </a>
            </li>
            <li>
                <a href="/training" class="nav-link">
                    <i class="bi bi-cpu"></i> Train your model
                </a>
            </li>
            <li>
                <a href="/embedding" class="nav-link">
                    <i class="bi bi-box"></i> Extract embeddings
                </a>
            </li>
            <li>
                <a href="/evaluation" class="nav-link">
                    <i class="bi bi-graph-up"></i> Evaluate performance
                </a>
            </li>
            <li>
                <a href="/inference" class="nav-link">
                    <i class="bi bi-lightning"></i> Deploy for inference
                </a>
            </li>
            <li>
                <a href="/checkpoint" class="nav-link">
                    <i class="bi bi-save"></i> Manage checkpoints
                </a>
            </li>
        </ol>
    </div>

    <div class="card mb-4 p-3 bg-light">
        <h2>System Requirements</h2>
        <p>Before you begin, ensure your system meets these requirements:</p>
        <ul>
            <li>Python 3.8 or higher</li>
            <li>CUDA-capable GPU (for GPU acceleration)</li>
            <li>16GB RAM minimum</li>
            <li>50GB free disk space</li>
        </ul>
        <button class="btn btn-primary mt-3" id="check-hardware-btn">
            <i class="bi bi-cpu"></i> Check System Compatibility
        </button>
        <div id="hardware-report" class="mt-3" style="display: none;"></div>
    </div>

    <div class="card mb-4 p-3 bg-light">
        <h2>Getting Help</h2>
        <p>If you need assistance:</p>
        <ul>
            <li>Check the <a href="/docs">documentation</a></li>
            <li>Visit our <a href="/examples">example projects</a></li>
            <li>Join our <a href="/community">community forum</a></li>
        </ul>
    </div>

    <div class="card mb-4 p-3 bg-light">
        <h2>Start Building</h2>
        <p>Ready to begin? Start with the introduction to learn more about ImpressionCore's capabilities.</p>
        <a href="/intro" class="btn btn-primary btn-lg">
            <i class="bi bi-arrow-right"></i> Begin Walkthrough
        </a>
    </div>
</div>

<script>
document.getElementById('check-hardware-btn').addEventListener('click', function() {
    this.disabled = true;
    this.innerHTML = '<i class="bi bi-hourglass-split"></i> Checking...';
    
    const reportDiv = document.getElementById('hardware-report');
    reportDiv.style.display = 'block';
    reportDiv.innerHTML = '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>';

    fetch('/check_hardware')
        .then(response => response.json())
        .then(data => {
            let html = '<div class="alert ' + (data.suitable ? 'alert-success' : 'alert-warning') + '">';
            html += '<h5>' + (data.suitable ? '✓ System Check Passed' : '⚠ System Check Warning') + '</h5>';
            html += '<ul class="mb-0">';
            for (const [key, value] of Object.entries(data.specs)) {
                html += `<li>${key}: ${value}</li>`;
            }
            html += '</ul></div>';
            reportDiv.innerHTML = html;
        })
        .catch(error => {
            reportDiv.innerHTML = '<div class="alert alert-danger">Error checking hardware: ' + error.message + '</div>';
        })
        .finally(() => {
            this.disabled = false;
            this.innerHTML = '<i class="bi bi-cpu"></i> Check System Compatibility';
        });
});
</script>
{% endblock %}
