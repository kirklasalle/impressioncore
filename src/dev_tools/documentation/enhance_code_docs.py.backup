#!/usr/bin/env python3
"""
ImpressionCore: Code Documentation Enhancement System

This script automatically enhances code documentation across the ImpressionCore
project by adding standardized headers, improving docstrings, and implementing
a comprehensive tagging system.

File: scripts/documentation/enhance_code_docs.py
Project: ImpressionCore - Brain-Inspired Multimodal AI Framework
Created: 2025-05-24
Modified: 2025-05-24
Version: 1.0.0

Authors:
- Kirk LaSalle <kirk@impressioncore.ai>
- GitHub Copilot

License: MIT
Copyright (c) 2025 ImpressionCore Team

Tags: [documentation, automation, code-enhancement, production]
Dependencies: [rich, pathlib, ast, typing]
Hardware Target: NVIDIA GTX 1050 Ti (4GB VRAM)

Description:
Comprehensive code documentation enhancement system that automatically:
- Adds standardized file headers to Python files
- Enhances docstrings with proper formatting and examples
- Implements consistent tagging system
- Extracts and categorizes TODO items
- Generates documentation health reports

Design Philosophy:
- Automated but configurable enhancement
- Preserves existing documentation while improving it
- Focuses on memory optimization documentation
- Ensures consistency across the entire codebase

TODO:
- Add support for JavaScript/TypeScript files
- Implement docstring quality scoring
- Add integration with git hooks
"""

import os
import sys
import ast
import re
from pathlib import Path
from typing import Dict, List, Optional, Union, Any, Tuple
from datetime import datetime
from dataclasses import dataclass
import argparse

# Add src to path for imports
sys.path.insert(0, str(Path(__file__).parent.parent.parent / "src"))

# Rich imports for beautiful terminal output
from rich.console import Console
from rich.table import Table
from rich.progress import Progress, TaskID
from rich.panel import Panel
from rich.syntax import Syntax
from rich.text import Text
from rich import print as rprint

__version__ = "1.0.0"
__author__ = "Kirk LaSalle & GitHub Copilot"
__license__ = "MIT"
__status__ = "Production"

console = Console()

@dataclass
class FileAnalysis:
    """Analysis results for a Python file."""
    filepath: Path
    has_header: bool
    has_module_docstring: bool
    missing_docstrings: List[str]
    todo_items: List[Dict[str, Any]]
    tags: List[str]
    complexity_score: int
    memory_docs: bool
    examples_present: bool

@dataclass
class DocumentationStats:
    """Overall documentation statistics."""
    total_files: int
    files_with_headers: int
    files_with_docstrings: int
    total_functions: int
    documented_functions: int
    total_classes: int
    documented_classes: int
    total_todos: int
    memory_documented_files: int

class CodeDocumentationEnhancer:
    """
    Comprehensive code documentation enhancement system.
    
    This class provides automated enhancement of Python code documentation
    including standardized headers, improved docstrings, and consistent tagging.
    
    Attributes:
        project_root (Path): Root directory of the ImpressionCore project
        src_dir (Path): Source code directory
        config (Dict[str, Any]): Configuration for enhancement process
        stats (DocumentationStats): Documentation statistics
    
    Memory Considerations:
        - Processes files incrementally to minimize memory usage
        - Uses AST parsing for efficient code analysis
        - Implements progress tracking for large codebases
    
    Examples:
        >>> enhancer = CodeDocumentationEnhancer()
        >>> enhancer.analyze_project()
        >>> enhancer.generate_report()
        >>> enhancer.enhance_all_files()
      Notes:        - Preserves existing documentation while enhancing it
        - Creates backups before making changes
        - Supports dry-run mode for safe testing
    """
    
    def __init__(self, project_root: Optional[Path] = None, verbose: bool = False):
        """
        Initialize the documentation enhancer.
        
        Args:
            project_root (Optional[Path]): Root directory of project.
                                         Defaults to auto-detection.
            verbose (bool): Enable verbose output for debugging.
        """
        self.project_root = project_root or self._find_project_root()
        self.src_dir = self.project_root / "src"
        self.docs_dir = self.project_root / "docs"
        self.verbose = verbose
        
        if self.verbose:
            console.print(f"[cyan]Debug:[/cyan] Project root: {self.project_root}")
            console.print(f"[cyan]Debug:[/cyan] Source directory: {self.src_dir}")
            console.print(f"[cyan]Debug:[/cyan] Docs directory: {self.docs_dir}")
        
        self.config = {
            "author": "Kirk LaSalle & GitHub Copilot",
            "license": "MIT",
            "copyright": "2025 ImpressionCore Team",
            "hardware_target": "NVIDIA GTX 1050 Ti (4GB VRAM)",
            "project_name": "ImpressionCore - Brain-Inspired Multimodal AI Framework"
        }
        
        self.stats = DocumentationStats(
            total_files=0, files_with_headers=0, files_with_docstrings=0,
            total_functions=0, documented_functions=0, total_classes=0,
            documented_classes=0, total_todos=0, memory_documented_files=0
        )
    
    def _find_project_root(self) -> Path:
        """Find the project root directory by looking for key files."""
        current = Path(__file__).parent
        while current.parent != current:
            if (current / "src").exists() and (current / "docs").exists():
                return current
            current = current.parent
        return Path.cwd()
      def analyze_file(self, filepath: Path) -> FileAnalysis:
        """
        Analyze a Python file for documentation quality.
        
        Args:
            filepath (Path): Path to the Python file to analyze
        
        Returns:
            FileAnalysis: Comprehensive analysis of the file
        
        Raises:
            ValueError: If file is not a Python file
            FileNotFoundError: If file doesn't exist
        """
        if self.verbose:
            console.print(f"[cyan]Debug:[/cyan] Analyzing file: {filepath}")
            
        if not filepath.exists():
            raise FileNotFoundError(f"File not found: {filepath}")
        
        if filepath.suffix != ".py":
            raise ValueError(f"Not a Python file: {filepath}")
        
        content = filepath.read_text(encoding='utf-8')
        
        if self.verbose:
            console.print(f"[cyan]Debug:[/cyan] File size: {len(content)} characters")
        
        # Parse AST for analysis
        try:
            tree = ast.parse(content)
            if self.verbose:
                console.print(f"[cyan]Debug:[/cyan] AST parsing successful")
        except SyntaxError as e:
            console.print(f"[red]Syntax error in {filepath}: {e}[/red]")
            if self.verbose:
                console.print(f"[cyan]Debug:[/cyan] Line {e.lineno}: {e.text}")
            return FileAnalysis(
                filepath=filepath, has_header=False, has_module_docstring=False,
                missing_docstrings=[], todo_items=[], tags=[], complexity_score=0,
                memory_docs=False, examples_present=False
            )
        
        # Analyze file structure
        has_header = self._has_standard_header(content)
        has_module_docstring = self._has_module_docstring(tree)
        missing_docstrings = self._find_missing_docstrings(tree)
        todo_items = self._extract_todos(content)
        tags = self._extract_tags(content)
        complexity_score = self._calculate_complexity(tree)
        memory_docs = self._has_memory_documentation(content)
        examples_present = self._has_examples(content)
        
        if self.verbose:
            console.print(f"[cyan]Debug:[/cyan] Analysis results:")
            console.print(f"  - Has header: {has_header}")
            console.print(f"  - Has module docstring: {has_module_docstring}")
            console.print(f"  - Missing docstrings: {len(missing_docstrings)}")
            console.print(f"  - TODO items: {len(todo_items)}")
            console.print(f"  - Tags: {tags}")
            console.print(f"  - Complexity score: {complexity_score}")
            console.print(f"  - Memory docs: {memory_docs}")
            console.print(f"  - Examples present: {examples_present}")
        
        return FileAnalysis(
            filepath=filepath,
            has_header=has_header,
            has_module_docstring=has_module_docstring,
            missing_docstrings=missing_docstrings,
            todo_items=todo_items,
            tags=tags,
            complexity_score=complexity_score,
            memory_docs=memory_docs,
            examples_present=examples_present
        )
    
    def _has_standard_header(self, content: str) -> bool:
        """Check if file has a standard ImpressionCore header."""
        header_indicators = [
            "ImpressionCore:",
            "File:",
            "Project:",
            "Created:",
            "Authors:",
            "License:"
        ]
        return all(indicator in content[:2000] for indicator in header_indicators)
    
    def _has_module_docstring(self, tree: ast.AST) -> bool:
        """Check if module has a docstring."""
        if (tree.body and 
            isinstance(tree.body[0], ast.Expr) and 
            isinstance(tree.body[0].value, ast.Constant) and 
            isinstance(tree.body[0].value.value, str)):
            return True
        return False
    
    def _find_missing_docstrings(self, tree: ast.AST) -> List[str]:
        """Find functions and classes missing docstrings."""
        missing = []
        
        for node in ast.walk(tree):
            if isinstance(node, (ast.FunctionDef, ast.ClassDef, ast.AsyncFunctionDef)):
                # Check if it has a docstring
                if not (node.body and 
                        isinstance(node.body[0], ast.Expr) and 
                        isinstance(node.body[0].value, ast.Constant) and 
                        isinstance(node.body[0].value.value, str)):
                    node_type = "function" if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) else "class"
                    missing.append(f"{node_type}: {node.name}")
        
        return missing
    
    def _extract_todos(self, content: str) -> List[Dict[str, Any]]:
        """Extract TODO items with categorization."""
        todo_pattern = re.compile(r'#\s*TODO\s*(\([^)]+\))?\s*:\s*(.+)', re.IGNORECASE)
        todos = []
        
        for line_num, line in enumerate(content.split('\n'), 1):
            match = todo_pattern.search(line)
            if match:
                priority = match.group(1).strip('()') if match.group(1) else "MEDIUM"
                description = match.group(2).strip()
                
                todos.append({
                    "line": line_num,
                    "priority": priority,
                    "description": description,
                    "category": self._categorize_todo(description)
                })
        
        return todos
    
    def _categorize_todo(self, description: str) -> str:
        """Categorize TODO items by content."""
        description_lower = description.lower()
        
        if any(term in description_lower for term in ['memory', 'vram', 'gpu', 'optimization']):
            return "MEMORY"
        elif any(term in description_lower for term in ['test', 'testing', 'unit test']):
            return "TESTING"
        elif any(term in description_lower for term in ['performance', 'speed', 'optimization']):
            return "PERFORMANCE"
        elif any(term in description_lower for term in ['doc', 'documentation', 'comment']):
            return "DOCUMENTATION"
        elif any(term in description_lower for term in ['feature', 'implement', 'add']):
            return "FEATURE"
        else:
            return "GENERAL"
    
    def _extract_tags(self, content: str) -> List[str]:
        """Extract tags from file content."""
        tag_patterns = [
            re.compile(r'Tags:\s*\[([^\]]+)\]'),
            re.compile(r'tags:\s*\[([^\]]+)\]'),
            re.compile(r'#\s*Tags:\s*(.+)', re.IGNORECASE)
        ]
        
        tags = []
        for pattern in tag_patterns:
            matches = pattern.findall(content)
            for match in matches:
                # Split by comma and clean up
                tag_list = [tag.strip() for tag in match.split(',')]
                tags.extend(tag_list)
        
        # Remove duplicates and empty tags
        return list(set(tag for tag in tags if tag))
    
    def _calculate_complexity(self, tree: ast.AST) -> int:
        """Calculate a simple complexity score for the file."""
        complexity = 0
        
        for node in ast.walk(tree):
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                complexity += 1
            elif isinstance(node, ast.ClassDef):
                complexity += 2
            elif isinstance(node, (ast.If, ast.For, ast.While, ast.Try)):
                complexity += 1
        
        return complexity
    
    def _has_memory_documentation(self, content: str) -> bool:
        """Check if file contains memory-related documentation."""
        memory_keywords = [
            "memory", "vram", "gpu", "optimization", "gradient checkpointing",
            "attention slicing", "cpu offload", "memory efficient"
        ]
        content_lower = content.lower()
        return any(keyword in content_lower for keyword in memory_keywords)
    
    def _has_examples(self, content: str) -> bool:
        """Check if file contains usage examples."""
        example_indicators = [
            "Examples:", ">>> ", "Example:", "Usage:", "How to use"
        ]
        return any(indicator in content for indicator in example_indicators)
      def generate_standard_header(self, filepath: Path, analysis: FileAnalysis) -> str:
        """
        Generate a standard header for a Python file.
        
        Args:
            filepath (Path): Path to the file
            analysis (FileAnalysis): Analysis results for the file
        
        Returns:
            str: Formatted header string
        """
        relative_path = filepath.relative_to(self.src_dir)
        today = datetime.now().strftime("%Y-%m-%d")
        
        if self.verbose:
            console.print(f"[cyan]Debug:[/cyan] Generating header for {relative_path}")
        
        # Determine module purpose from filename and path
        module_purpose = self._infer_module_purpose(filepath)
        
        # Generate tags based on file location and analysis
        auto_tags = self._generate_auto_tags(filepath, analysis)
        
        if self.verbose:
            console.print(f"[cyan]Debug:[/cyan] Module purpose: {module_purpose}")
            console.print(f"[cyan]Debug:[/cyan] Auto-generated tags: {auto_tags}")
        
        header = f'''#!/usr/bin/env python3
"""
ImpressionCore: {module_purpose}

[Brief description of the module's purpose and functionality]

File: {relative_path}
Project: {self.config["project_name"]}
Created: {today}
Modified: {today}
Version: 1.0.0

Authors:
- {self.config["author"]}

License: {self.config["license"]}
Copyright (c) {self.config["copyright"]}

Tags: {auto_tags}
Dependencies: [list of key dependencies]
Hardware Target: {self.config["hardware_target"]}

Description:
[Detailed description of the module, its purpose, key algorithms,
and how it fits into the ImpressionCore architecture]

Design Philosophy:
[Brief explanation of design decisions, optimization strategies,
and memory management considerations]

TODO:
- [List any planned improvements]
- [Performance optimizations]
- [Feature additions]

Examples:
```python
# Basic usage example
from {str(relative_path).replace('/', '.').replace('.py', '')} import ClassName
instance = ClassName()
result = instance.method()
```

Notes:
- [Important implementation notes]
- [Memory usage considerations]
- [Performance characteristics]
"""

'''
        return header
    
    def _infer_module_purpose(self, filepath: Path) -> str:
        """Infer module purpose from filepath."""
        path_parts = filepath.parts
        
        if "memory" in str(filepath):
            return "Memory Management System"
        elif "multimodal" in str(filepath):
            return "Multimodal Processing Pipeline"
        elif "brain" in str(filepath) or "cognitive" in str(filepath):
            return "Brain Simulation Components"
        elif "training" in str(filepath):
            return "Training Infrastructure"
        elif "inference" in str(filepath):
            return "Inference Engine"
        elif "utils" in str(filepath):
            return "Utility Functions"
        elif "api" in str(filepath):
            return "API Interface"
        elif "web" in str(filepath):
            return "Web Interface"
        else:
            return "Core Component"
    
    def _generate_auto_tags(self, filepath: Path, analysis: FileAnalysis) -> str:
        """Generate automatic tags based on file analysis."""
        tags = set()
        
        # Location-based tags
        path_str = str(filepath)
        if "core" in path_str:
            tags.add("core")
        if "utils" in path_str:
            tags.add("utils")
        if "memory" in path_str:
            tags.add("memory")
        if "multimodal" in path_str:
            tags.add("multimodal")
        if "training" in path_str:
            tags.add("training")
        if "inference" in path_str:
            tags.add("inference")
        if "web" in path_str:
            tags.add("web")
        
        # Analysis-based tags
        if analysis.memory_docs:
            tags.add("memory-optimized")
        if analysis.complexity_score > 10:
            tags.add("complex")
        elif analysis.complexity_score < 3:
            tags.add("simple")
          # Add existing tags
        tags.update(analysis.tags)
        
        # Default tags
        tags.add("production")
        
        return "[" + ", ".join(sorted(tags)) + "]"
    
    def enhance_file_documentation(self, filepath: Path, dry_run: bool = False) -> bool:
        """
        Enhance documentation for a single file.
        
        Args:
            filepath (Path): Path to the file to enhance
            dry_run (bool): If True, don't actually modify files
        
        Returns:
            bool: True if file was modified (or would be in dry_run)
        """
        try:
            if self.verbose:
                console.print(f"[cyan]Debug:[/cyan] Enhancing file: {filepath}")
                
            analysis = self.analyze_file(filepath)
            content = filepath.read_text(encoding='utf-8')
            modified = False
            
            if self.verbose:
                console.print(f"[cyan]Debug:[/cyan] File analysis complete, has header: {analysis.has_header}")
            
            # Add header if missing
            if not analysis.has_header:
                if self.verbose:
                    console.print(f"[cyan]Debug:[/cyan] Generating header for {filepath.name}")
                    
                header = self.generate_standard_header(filepath, analysis)
                
                # Find where to insert header (after shebang/encoding if present)
                lines = content.split('\n')
                insert_line = 0
                
                for i, line in enumerate(lines):
                    if line.startswith('#!') or 'coding:' in line or 'encoding:' in line:
                        insert_line = i + 1
                    else:
                        break
                
                if self.verbose:
                    console.print(f"[cyan]Debug:[/cyan] Inserting header at line {insert_line}")
                
                # Insert header
                lines.insert(insert_line, header)
                content = '\n'.join(lines)
                modified = True
            
            # Write changes if not dry run
            if modified and not dry_run:
                if self.verbose:
                    console.print(f"[cyan]Debug:[/cyan] Creating backup and writing enhanced file")
                    
                # Create backup
                backup_path = filepath.with_suffix('.py.bak')
                filepath.rename(backup_path)
                
                # Write enhanced file
                filepath.write_text(content, encoding='utf-8')
                
                console.print(f"[green]Enhanced:[/green] {filepath}")
            elif modified and dry_run:
                console.print(f"[yellow]Would enhance:[/yellow] {filepath}")
              return modified
            
        except Exception as e:
            console.print(f"[red]Error enhancing {filepath}: {e}[/red]")
            return False
    
    def analyze_project(self) -> None:
        """Analyze the entire project for documentation quality."""
        console.print("[bold blue]Analyzing ImpressionCore documentation...[/bold blue]")
        
        python_files = list(self.src_dir.rglob("*.py"))
        
        if self.verbose:
            console.print(f"[cyan]Debug:[/cyan] Found {len(python_files)} Python files")
            console.print(f"[cyan]Debug:[/cyan] Source directory: {self.src_dir}")
        
        with Progress() as progress:
            task = progress.add_task("Analyzing files...", total=len(python_files))
            
            analyses = []
            errors = 0
            for i, filepath in enumerate(python_files):
                try:
                    if self.verbose and i % 50 == 0:  # Every 50 files in verbose mode
                        console.print(f"[cyan]Debug:[/cyan] Progress: {i}/{len(python_files)} files")
                        
                    analysis = self.analyze_file(filepath)
                    analyses.append(analysis)
                    
                    # Update stats
                    self.stats.total_files += 1
                    if analysis.has_header:
                        self.stats.files_with_headers += 1
                    if analysis.has_module_docstring:
                        self.stats.files_with_docstrings += 1
                    if analysis.memory_docs:
                        self.stats.memory_documented_files += 1
                    
                    self.stats.total_todos += len(analysis.todo_items)
                    
                except Exception as e:
                    console.print(f"[red]Error analyzing {filepath}: {e}[/red]")
                    errors += 1
                    if self.verbose:
                        import traceback
                        console.print(f"[cyan]Debug:[/cyan] Full traceback:")
                        console.print(traceback.format_exc())
                
                progress.update(task, advance=1)
        
        # Store analyses for reporting
        self.analyses = analyses
        console.print(f"[green]Analyzed {len(analyses)} Python files[/green]")
        
        if self.verbose:
            console.print(f"[cyan]Debug:[/cyan] Analysis complete:")
            console.print(f"  - Total files: {self.stats.total_files}")
            console.print(f"  - Files with headers: {self.stats.files_with_headers}")
            console.print(f"  - Files with docstrings: {self.stats.files_with_docstrings}")
            console.print(f"  - Memory documented files: {self.stats.memory_documented_files}")
            console.print(f"  - Total TODOs: {self.stats.total_todos}")
            console.print(f"  - Errors encountered: {errors}")
    
    def generate_report(self) -> None:
        """Generate a comprehensive documentation report."""
        if not hasattr(self, 'analyses'):
            console.print("[red]Run analyze_project() first[/red]")
            return
        
        # Overall statistics table
        stats_table = Table(title="Documentation Statistics")
        stats_table.add_column("Metric", style="cyan")
        stats_table.add_column("Count", style="green")
        stats_table.add_column("Percentage", style="yellow")
        
        total = self.stats.total_files
        stats_table.add_row("Total Files", str(total), "100%")
        stats_table.add_row("Files with Headers", 
                           str(self.stats.files_with_headers),
                           f"{(self.stats.files_with_headers/total*100):.1f}%")
        stats_table.add_row("Files with Docstrings",
                           str(self.stats.files_with_docstrings),
                           f"{(self.stats.files_with_docstrings/total*100):.1f}%")
        stats_table.add_row("Memory Documented Files",
                           str(self.stats.memory_documented_files),
                           f"{(self.stats.memory_documented_files/total*100):.1f}%")
        stats_table.add_row("Total TODO Items", str(self.stats.total_todos), "-")
        
        console.print(stats_table)
        
        # Files needing attention
        needs_attention = []
        for analysis in self.analyses:
            score = self._calculate_doc_score(analysis)
            if score < 70:  # Threshold for needing attention
                needs_attention.append((analysis, score))
        
        if needs_attention:
            attention_table = Table(title="Files Needing Documentation Attention")
            attention_table.add_column("File", style="cyan")
            attention_table.add_column("Score", style="red")
            attention_table.add_column("Issues", style="yellow")
            
            for analysis, score in sorted(needs_attention, key=lambda x: x[1]):
                issues = []
                if not analysis.has_header:
                    issues.append("No header")
                if not analysis.has_module_docstring:
                    issues.append("No module docstring")
                if analysis.missing_docstrings:
                    issues.append(f"{len(analysis.missing_docstrings)} missing docstrings")
                if not analysis.memory_docs:
                    issues.append("No memory docs")
                
                attention_table.add_row(
                    str(analysis.filepath.relative_to(self.src_dir)),
                    f"{score}%",
                    ", ".join(issues)
                )
            
            console.print(attention_table)
        
        # TODO summary by category
        todo_categories = {}
        for analysis in self.analyses:
            for todo in analysis.todo_items:
                category = todo["category"]
                todo_categories[category] = todo_categories.get(category, 0) + 1
        
        if todo_categories:
            todo_table = Table(title="TODO Items by Category")
            todo_table.add_column("Category", style="cyan")
            todo_table.add_column("Count", style="green")
            
            for category, count in sorted(todo_categories.items(), key=lambda x: x[1], reverse=True):
                todo_table.add_row(category, str(count))
            
            console.print(todo_table)
    
    def _calculate_doc_score(self, analysis: FileAnalysis) -> int:
        """Calculate documentation quality score (0-100)."""
        score = 0
        
        # Header (20 points)
        if analysis.has_header:
            score += 20
        
        # Module docstring (20 points)
        if analysis.has_module_docstring:
            score += 20
        
        # Function/class docstrings (30 points)
        if not analysis.missing_docstrings:
            score += 30
        elif len(analysis.missing_docstrings) < 3:
            score += 20
        elif len(analysis.missing_docstrings) < 6:
            score += 10
        
        # Memory documentation (15 points)
        if analysis.memory_docs:
            score += 15
        
        # Examples (10 points)
        if analysis.examples_present:
            score += 10
        
        # Tags (5 points)
        if analysis.tags:
            score += 5
        
        return score
    
    def enhance_all_files(self, dry_run: bool = False) -> None:
        """
        Enhance documentation for all Python files in the project.
        
        Args:
            dry_run (bool): If True, don't actually modify files
        """
        if not hasattr(self, 'analyses'):
            console.print("[red]Run analyze_project() first[/red]")
            return
        
        console.print(f"[bold blue]Enhancing documentation ({'dry run' if dry_run else 'live mode'})...[/bold blue]")
        
        with Progress() as progress:
            task = progress.add_task("Enhancing files...", total=len(self.analyses))
            
            enhanced_count = 0
            for analysis in self.analyses:
                if self.enhance_file_documentation(analysis.filepath, dry_run):
                    enhanced_count += 1
                progress.update(task, advance=1)
        
        if dry_run:
            console.print(f"[yellow]Would enhance {enhanced_count} files[/yellow]")
        else:
            console.print(f"[green]Enhanced {enhanced_count} files[/green]")
    
    def extract_todos_to_file(self) -> None:
        """Extract all TODO items to a tracking document."""
        if not hasattr(self, 'analyses'):
            console.print("[red]Run analyze_project() first[/red]")
            return
        
        todos_by_category = {}
        for analysis in self.analyses:
            for todo in analysis.todo_items:
                category = todo["category"]
                if category not in todos_by_category:
                    todos_by_category[category] = []
                
                todos_by_category[category].append({
                    "file": str(analysis.filepath.relative_to(self.src_dir)),
                    "line": todo["line"],
                    "priority": todo["priority"],
                    "description": todo["description"]
                })
        
        # Generate TODO tracking document
        todo_doc = "# ImpressionCore TODO Tracking\n\n"
        todo_doc += f"_Generated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}_\n\n"
        
        for category, todos in sorted(todos_by_category.items()):
            todo_doc += f"## {category} ({len(todos)} items)\n\n"
            
            for todo in sorted(todos, key=lambda x: x["priority"]):
                todo_doc += f"- **{todo['priority']}**: {todo['description']}\n"
                todo_doc += f"  - File: `{todo['file']}:{todo['line']}`\n\n"
        
        # Write to docs directory
        todo_file = self.docs_dir / "developer" / "todo_tracking.md"
        todo_file.write_text(todo_doc, encoding='utf-8')
        
        console.print(f"[green]TODO tracking saved to:[/green] {todo_file}")

def main():
    """Main function for the documentation enhancement script."""
    parser = argparse.ArgumentParser(description="Enhance ImpressionCore code documentation")
    parser.add_argument("--analyze", action="store_true", help="Analyze project documentation")
    parser.add_argument("--enhance", action="store_true", help="Enhance all files")
    parser.add_argument("--dry-run", action="store_true", help="Dry run mode (no changes)")
    parser.add_argument("--extract-todos", action="store_true", help="Extract TODO items")
    parser.add_argument("--file", type=str, help="Enhance specific file")
    parser.add_argument("--verbose", "-v", action="store_true", help="Enable verbose output for debugging")
    
    args = parser.parse_args()
    
    # Initialize enhancer with verbose option
    enhancer = CodeDocumentationEnhancer(verbose=args.verbose)
    
    if args.analyze or not any([args.enhance, args.extract_todos, args.file]):
        enhancer.analyze_project()
        enhancer.generate_report()
    
    if args.extract_todos:
        if not hasattr(enhancer, 'analyses'):
            enhancer.analyze_project()
        enhancer.extract_todos_to_file()
    
    if args.enhance:
        if not hasattr(enhancer, 'analyses'):
            enhancer.analyze_project()
        enhancer.enhance_all_files(dry_run=args.dry_run)
    
    if args.file:
        filepath = Path(args.file)
        if filepath.exists():
            enhancer.enhance_file_documentation(filepath, dry_run=args.dry_run)
        else:
            console.print(f"[red]File not found: {filepath}[/red]")

if __name__ == "__main__":
    main()
